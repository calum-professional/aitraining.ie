  <!-- master header -->
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>document.documentElement.classList.add("js");</script>

    {% set keywordList = site.searchKeywords.join(" ") %}
    {% if page.type == "home" and page.url == "/" %}
      {% set pageTitle = keywordList + " " + site.homepageTitle %}
      {% set pageDescription = keywordList + " training courses in Dublin, Cork, Limerick and live online. Practical, instructor-led courses from " + site.organisation.name + "." %}
    {% elif page.type == "landing" %}
      {% set pageTitle = search.title %}
      {% set pageDescription = search.title + ". Instructor-led courses from " + site.organisation.name + ". View courses and upcoming dates." %}
    {% elif page.type == "course" %}
      {% set pageTitle = course.name + " Training" %}
      {% set pageDescription = course.descrip | striptags | truncate(155) %}
    {% elif page.type == "keyword" %}
      {% set pageTitle = keyword + " Training Courses, Dublin, Cork, Limerick, Ireland" %}
      {% set pageDescription = keyword + " training courses in Dublin, Cork, Limerick and live online. Compare courses and book a date with " + site.organisation.name + "." %}
    {% elif page.type == "schedule" %}
      {% set pageTitle = "Scheduled " + keywordList + " " + site.homepageTitle %}
      {% set pageDescription = "Upcoming " + keywordList + " course dates in Dublin, Cork, Limerick and live online. Choose a date and book your place." %}
    {% else %}
      {% set pageTitle = metaTitle or page.title or title or (keywordList + " " + site.homepageTitle) %}
      {% set pageDescription = description or (keywordList + " training courses in Dublin, Cork, Limerick and live online from " + site.organisation.name + ".") %}
    {% endif %}

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="https://{{ site.url }}{{ page.url }}">

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="https://{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.organisation.name }}">
    <meta name="theme-color" content="{{ branding.primary_color }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&display=swap">

    {% include "StructuredData/educationalOrganisation.njk" %}
    {% include "branding.njk" %}
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E6B57'/%3E%3Cpath d='M9 22l5-12h4l5 12h-3.4l-1-2.6h-5.2l-1 2.6zm5.4-5.4h3.2L16 12.4z' fill='%23fff'/%3E%3C/svg%3E">

    <script src="/js/site.js" defer></script>
  </head>
